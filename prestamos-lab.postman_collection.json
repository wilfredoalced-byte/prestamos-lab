{
  "info": {
    "_postman_id": "7c1f2a3e-prestamos-lab-2026",
    "name": "Prestamos Lab - Integrante 2",
    "description": "Pruebas de validaciones, CRUD de equipos y registro de prestamos/devoluciones. Ejecutar sobre una base de datos con datos de prueba (npm run seed).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "equipoId", "value": "" },
    { "key": "prestamoId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Login (obtener token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"correo\": \"ana@ejemplo.com\", \"password\": \"Clave123\"}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Login correcto (200)', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('token', pm.response.json().token);"
          ]
        }
      }]
    },
    {
      "name": "02 Equipos sin token (401)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/equipos" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Sin token responde 401', function () { pm.response.to.have.status(401); });"
      ] } }]
    },
    {
      "name": "03 Listar equipos (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/equipos"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Lista equipos con 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Es un arreglo', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
      ] } }]
    },
    {
      "name": "04 Crear equipo LAB-005 (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"codigo\": \"LAB-005\", \"nombre\": \"Osciloscopio\", \"categoria\": \"Medición\", \"condicion\": \"nuevo\"}" },
        "url": "{{baseUrl}}/equipos"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Equipo creado (201)', function () { pm.response.to.have.status(201); });",
        "pm.collectionVariables.set('equipoId', pm.response.json().equipo.id);"
      ] } }]
    },
    {
      "name": "05 Crear equipo sin codigo (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"nombre\": \"Sin codigo\"}" },
        "url": "{{baseUrl}}/equipos"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Falta el codigo responde 400', function () { pm.response.to.have.status(400); });"
      ] } }]
    },
    {
      "name": "06 Crear equipo con codigo repetido (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"codigo\": \"LAB-001\", \"nombre\": \"Repetido\", \"categoria\": \"Medición\"}" },
        "url": "{{baseUrl}}/equipos"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Codigo repetido responde 409', function () { pm.response.to.have.status(409); });"
      ] } }]
    },
    {
      "name": "07 Obtener equipo inexistente (404)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/equipos/99999"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Equipo inexistente responde 404', function () { pm.response.to.have.status(404); });"
      ] } }]
    },
    {
      "name": "08 Actualizar equipo LAB-005 (200)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"condicion\": \"regular\"}" },
        "url": "{{baseUrl}}/equipos/{{equipoId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Equipo actualizado (200)', function () { pm.response.to.have.status(200); });"
      ] } }]
    },
    {
      "name": "09 Registrar prestamo de LAB-002 (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"equipo_id\": 2, \"prestatario\": \"Saul Espinoza\", \"fecha_prestamo\": \"2026-11-03\", \"fecha_prevista\": \"2026-11-10\"}" },
        "url": "{{baseUrl}}/prestamos"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Prestamo registrado (201)', function () { pm.response.to.have.status(201); });",
        "pm.collectionVariables.set('prestamoId', pm.response.json().prestamo.id);"
      ] } }]
    },
    {
      "name": "10 Prestar el mismo equipo otra vez (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"equipo_id\": 2, \"prestatario\": \"Otra persona\", \"fecha_prestamo\": \"2026-11-03\", \"fecha_prevista\": \"2026-11-10\"}" },
        "url": "{{baseUrl}}/prestamos"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Doble prestamo responde 409', function () { pm.response.to.have.status(409); });"
      ] } }]
    },
    {
      "name": "11 Prestamo con fecha invalida (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"equipo_id\": 1, \"prestatario\": \"Prueba\", \"fecha_prestamo\": \"malo\", \"fecha_prevista\": \"2026-11-10\"}" },
        "url": "{{baseUrl}}/prestamos"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Fecha invalida responde 400', function () { pm.response.to.have.status(400); });"
      ] } }]
    },
    {
      "name": "12 Filtrar prestamos activos (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/prestamos?activos=true", "host": ["{{baseUrl}}"], "path": ["prestamos"], "query": [{ "key": "activos", "value": "true" }] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Filtro activos responde 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Todos los prestamos devueltos no aparecen', function () { pm.response.json().forEach(function (p) { pm.expect(p.fecha_devolucion).to.be.null; }); });"
      ] } }]
    },
    {
      "name": "13 Filtrar prestamos por equipo_id (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/prestamos?equipo_id=2", "host": ["{{baseUrl}}"], "path": ["prestamos"], "query": [{ "key": "equipo_id", "value": "2" }] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Filtro por equipo responde 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Solo prestamos del equipo 2', function () { pm.response.json().forEach(function (p) { pm.expect(p.equipo_id).to.eql(2); }); });"
      ] } }]
    },
    {
      "name": "14 Registrar devolucion (200)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"fecha_devolucion\": \"2026-11-05\"}" },
        "url": "{{baseUrl}}/prestamos/{{prestamoId}}/devolucion"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Devolucion registrada (200)', function () { pm.response.to.have.status(200); });"
      ] } }]
    },
    {
      "name": "15 Devolver de nuevo el mismo prestamo (409)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"fecha_devolucion\": \"2026-11-05\"}" },
        "url": "{{baseUrl}}/prestamos/{{prestamoId}}/devolucion"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Devolucion repetida responde 409', function () { pm.response.to.have.status(409); });"
      ] } }]
    },
    {
      "name": "16 Eliminar equipo con historial (409)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/equipos/1"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Equipo con historial no se elimina (409)', function () { pm.response.to.have.status(409); });"
      ] } }]
    },
    {
      "name": "17 Eliminar equipo LAB-005 (200)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/equipos/{{equipoId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Equipo sin historial se elimina (200)', function () { pm.response.to.have.status(200); });"
      ] } }]
    },
    {
      "name": "18 Listar prestamos sin token (401)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/prestamos" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Sin token responde 401', function () { pm.response.to.have.status(401); });"
      ] } }]
    }
  ]
}
